record(mbbo, "MBBO") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(OUT,  "@devsup.ptable alarm set mbbo")
    field(ZRST, "Zero")
    field(ONST, "One")
    field(TWST, "Two")
    field(THST, "Three")
    field(FRST, "Four")
    field(FVST, "Five")
    field(SXST, "Six")
    field(SVST, "Seven")
    field(EIST, "Eight")
    field(NIST, "Nine")
    field(TEST, "Ten")
    field(ELST, "Eleven")
    field(TVST, "Twelve")
    field(TTST, "Thirteen")
    field(FTST, "Fourteen")
    field(FFST, "Fifteen")
    # Has RVAL field but this is unsuitable for output use
    ${HASHTAG="#"}field(VAL,  "8")
}

