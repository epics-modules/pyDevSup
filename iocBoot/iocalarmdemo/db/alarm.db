record(mbbi, "MBBI") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm get mbbi")
    field(ZRVL, 0)
    field(ONVL, 1)
    field(TWVL, 2)
    field(THVL, 3)
    field(FRVL, 4)
    field(FVVL, 5)
    field(SXVL, 6)
    field(SVVL, 7)
    field(EIVL, 8)
    field(NIVL, 9)
    field(TEVL, 10)
    field(ELVL, 11)
    field(TVVL, 12)
    field(TTVL, 13)
    field(FTVL, 14)
    field(FFVL, 15)
    field(ZRST, "Zero")
    field(ONST, "One")
    field(TWST, "Two")
    field(THST, "Three")
    field(FRST, "Four")
    field(FVST, "Five")
    field(SXST, "Six")
    field(SVST, "Seven")
    field(EIST, "Eight")
    field(NIST, "Nine")
    field(TEST, "Ten")
    field(ELST, "Eleven")
    field(TVST, "Twelve")
    field(TTST, "Thirteen")
    field(FTST, "Fourteen")
    field(FFST, "Fifteen")
    info("pyfield", ${RVAL="VAL"})
    ${HASHTAG="#"}field(VAL,  "18")
    field(SCAN, "I/O Intr")
}

