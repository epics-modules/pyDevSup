# Output parameters
record(calcout, "CALCOUT") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(OUT,  "@devsup.ptable alarm set calcout")
    # No RVAL field
    ${HASHTAG="#"}field(VAL,  "1")
    field(INPA, "CALCOUT")
    field(CALC, "A+1")
    field(SCAN, "5 second")
}

record(aao, "AAO") {
    field(PINI, ${PINI="NO"})
    # NB, an array needs to have at least two elements. Or it is not an array.
    field(NELM, "2")
    field(DTYP, "Python Device")
    field(FTVL, "LONG")
    # No RVAL field
    field(OUT,  "@devsup.ptable alarm set aao")
    # Cannot set VAL
    #field(VAL,  "2")
}

record(ao, "AO") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(OUT,  "@devsup.ptable alarm set ao")
    # Has RVAL field but this is unsuitable for output use
    ${HASHTAG="#"}field(VAL,  "3")
}

record(bo, "BO") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(OUT,  "@devsup.ptable alarm set bo")
    # Has RVAL field but this is unsuitable for output use
    ${HASHTAG="#"}field(${RVAL="VAL"},  "4")
}

