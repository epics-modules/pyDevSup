# Input parameters
record(aai, "AAI") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    # NB, an array needs to have at least two elements. Or it is not an array.
    field(NELM, "2")
    field(FTVL, "LONG")
    field(INP,  "@devsup.ptable alarm get aai")
    # No RVAL field
    # Cannot set VAL
    #field(VAL,  "{11}")
    field(SCAN, "I/O Intr")
}

record(ai, "AI") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm get ai")
    info("pyfield", ${RVAL="VAL"})
    ${HASHTAG="#"}field(VAL,  "12")
    field(SCAN, "I/O Intr")
}

record(bi, "BI") {
    field(PINI, ${PINI="NO"})
    field(DTYP, "Python Device")
    field(INP,  "@devsup.ptable alarm get bi")
    info("pyfield", ${RVAL="VAL"})
    ${HASHTAG="#"}field(VAL,  "13")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
    field(SCAN, "I/O Intr")
}

